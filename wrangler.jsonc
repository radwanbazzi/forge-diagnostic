/**
 * Wrangler configuration — Forge SAT Diagnostic Worker.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forge-diagnostic",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// D1 (SQLite) database — available in the Worker as `env.DB`.
	// `database_id` is the real remote database created with
	// `npx wrangler d1 create forge_diagnostic` (region WEUR). Local dev + tests use a
	// LOCAL SQLite store; only `--remote` commands touch this remote database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "forge_diagnostic",
			"database_id": "99da9d06-4bc6-42d0-9618-d3907d512730",
			"migrations_dir": "migrations"
		}
	],

	// Static assets (F-M0): the built Astro landing in web/dist is served for matching
	// paths; every other request (e.g. /api/*) runs the Worker. Same origin, no CORS.
	"assets": {
		"directory": "./web/dist"
	}
}
