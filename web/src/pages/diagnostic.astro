---
// F-M1 — the interactive diagnostic flow. This static Astro page loads the Forge
// brand tokens + fonts, then mounts the React island (DiagnosticFlow) which runs the
// 22-question flow entirely client-side. No backend call in F-M1 (wiring is F-M2).
import DiagnosticFlow from '../components/DiagnosticFlow.tsx';

const title = 'Forge SAT Diagnostic';
const description = 'Answer ~22 quick questions and see where your SAT score really stands.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- The diagnostic is a private tool, not an SEO landing page. -->
		<meta name="robots" content="noindex,nofollow" />
		<meta name="theme-color" content="#F2EFE6" />
		<link rel="icon" href="/forge-icon.svg" type="image/svg+xml" />
		<!-- Self-hosted fonts (F-M4a): no Google Fonts round-trip. Preload the latin
		     subsets shown above the fold, then load the full @font-face sheet. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/anton-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/ibm-plex-mono-500-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href="/fonts/forge-fonts.css" />
		<style is:global>
			:root {
				--bone: #f2efe6;
				--ink: #141310;
				--molten: #d4331f;
				--molten-dark: #a5290f;
				--amber: #c9a227;
				--grey: #8a857a;
				--rule: #e3ddcf;
				--ink-soft: #4a443b;
				--card: #ffffff;
				/* AA-compliant variants for SMALL coloured text on light backgrounds
				   (F-M4a). Vivid --molten/--grey stay for fills, borders, and large
				   display type. */
				--molten-text: #c22f16;
				--grey-text: #6b665c;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			html {
				-webkit-text-size-adjust: 100%;
			}
			body {
				background: var(--bone);
				color: var(--ink);
				font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				font-size: 17px;
				line-height: 1.55;
				-webkit-font-smoothing: antialiased;
				text-rendering: optimizeLegibility;
			}
		</style>
	</head>

	<body>
		<!-- client:load → hydrate the React island as soon as the page loads. -->
		<DiagnosticFlow client:load />
	</body>
</html>
